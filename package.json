{
  "name": "companion-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- next dev",
    "build": "dotenv -e .env -- next build",
    "start": "dotenv -e .env -- next start",
    "lint": "next lint",
    "prisma:seed:all": "pnpm prisma:migrate && pnpm prisma:seed && pnpm prisma:seed:assets",
    "prisma:generate": "dotenv -e .env -- prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev --schema prisma/app/schema.prisma",
    "prisma:seed": "dotenv -e .env -- prisma db seed",
    "prisma:seed:assets": "dotenv -e .env -- tsx prisma/seed-assets.ts",
    "prisma:seed:categories": "dotenv -e .env -- tsx prisma/seed-categories.ts",
    "prisma:seed:companions": "dotenv -e .env -- tsx prisma/seed-companions.ts",
    "library:import": "dotenv -e .env -- tsx prisma/import-companions.ts",
    "worker": "dotenv -e .env -- tsx worker/index.ts",
    "predev": "dotenv -e .env -- node scripts/sync-assets.mjs",
    "prebuild": "dotenv -e .env -- node scripts/sync-assets.mjs",
    "smoke:replicate": "node --env-file=.env scripts/replicate-smoke.mjs",
    "check:tree": "bash scripts/check-tree.sh",
    "sync:assets": "dotenv -e .env -- node scripts/sync-assets.mjs",
    "nsfw:worker": "dotenv -e .env -- node scripts/nsfw-worker.mjs",
    "gen:thumbnails": "dotenv -e .env -- tsx scripts/generate-companion-thumbnails.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.52.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^6.19.2",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.3",
    "companion-platform": "link:",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "next": "^15.1.0",
    "openai": "^6.22.0",
    "pg": "^8.20.0",
    "react": "19.2.5",
    "react-dom": "^19.2.5",
    "react-native": "^0.84.0",
    "react-native-web": "^0.21.2",
    "redis": "^5.11.0",
    "replicate": "^1.4.0",
    "stripe": "^22.0.1",
    "supabase": "^2.76.17"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@eslint/js": "^9.39.3",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ai": "^6.0.92",
    "autoprefixer": "^10.4.24",
    "bullmq": "^5.70.4",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "eslint-plugin-react": "^7.37.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "globals": "^17.3.0",
    "ngrok": "5.0.0-beta.2",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
