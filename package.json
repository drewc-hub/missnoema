{
  "name": "companion-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "dotenv -e .env -- next dev",
    "build": "dotenv -e .env -- next build",
    "start": "dotenv -e .env -- next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint",
    "prisma:seed:all": "pnpm prisma:migrate && pnpm prisma:seed && pnpm prisma:seed:assets",
    "prisma:generate": "dotenv -e .env -- prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "dotenv -e .env -- prisma db seed",
    "prisma:seed:assets": "dotenv -e .env -- tsx prisma/seed-assets.ts",
    "prisma:seed:categories": "dotenv -e .env -- tsx prisma/seed-categories.ts",
    "prisma:seed:companions": "dotenv -e .env -- tsx prisma/seed-companions.ts",
    "library:import": "dotenv -e .env -- tsx prisma/import-companions.ts",
    "worker": "dotenv -e .env -- tsx worker/index.ts",
    "predev": "dotenv -e .env -- node scripts/sync-assets.mjs",
    "prebuild": "dotenv -e .env -- node scripts/sync-assets.mjs",
    "smoke:replicate": "node --env-file=.env scripts/replicate-smoke.mjs",
    "check:tree": "bash scripts/check-tree.sh",
    "sync:assets": "dotenv -e .env -- node scripts/sync-assets.mjs",
    "nsfw:worker": "dotenv -e .env -- node scripts/nsfw-worker.mjs",
    "test:diversity": "vitest run tests/seed-companions.diversity.test.ts",
    "gen:thumbnails": "dotenv -e .env -- tsx scripts/generate-companion-thumbnails.ts"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^3.0.36",
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/togetherai": "^2.0.51",
    "@dotenvx/dotenvx": "^1.66.0",
    "@faker-js/faker": "^10.4.0",
    "@gradio/client": "^2.2.0",
    "@huggingface/inference": "^4.13.15",
    "@mistralai/mistralai": "^1.15.1",
    "@netlify/database": "^1.0.0",
    "@openai/openai": "jsr:^6.37.0",
    "@pollinations/model-context-protocol": "^1.0.15",
    "@pollinations/react": "^2.0.7",
    "@prisma/client": "^6.19.3",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.105.4",
    "@zeldafan0225/ai_horde": "^6.0.2",
    "ai": "^6.0.182",
    "bcryptjs": "^3.0.3",
    "companion-platform": "link:",
    "drizzle-orm": "1.0.0-beta.22",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "netlify": "^26.0.1",
    "next": "^15.5.18",
    "openai": "^6.37.0",
    "pg": "^8.20.0",
    "react": "16.8.0",
    "react-dom": "^16.14.0",
    "react-native": "^0.84.1",
    "react-native-web": "^0.21.2",
    "redis": "^5.12.1",
    "replicate": "^1.4.0",
    "stripe": "^22.1.1",
    "supabase": "^2.98.2",
    "supabase-cli": "^0.0.21",
    "webpack": "^5.106.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "@types/react": "^16.14.69",
    "@types/react-dom": "^16.9.25",
    "autoprefixer": "^10.5.0",
    "bullmq": "^5.76.8",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "eslint-plugin-react": "^7.37.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "globals": "^17.6.0",
    "ngrok": "5.0.0-beta.2",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
