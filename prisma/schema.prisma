generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "mynoema", "next_auth", "public"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model gen_jobs {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String
  kind          String
  prompt        String
  status        gen_status @default(queued)
  error         String?
  output_bucket String?
  output_path   String?
  output_mime   String?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @db.Timestamptz(6)

  @@index([status, created_at], map: "idx_gen_jobs_status_created_at")
  @@schema("public")
}

model Companion {
  id                                                                     String                  @id @default(cuid())
  ownerId                                                                String?
  name                                                                   String
  slug                                                                   String                  @unique
  description                                                            String
  tags                                                                   String[]
  archetype                                                              String?
  profile                                                                Json
  visibility                                                             Visibility              @default(PUBLIC)
  contentRating                                                          ContentRating           @default(SAFE)
  likes                                                                  Int                     @default(0)
  views                                                                  Int                     @default(0)
  saves                                                                  Int                     @default(0)
  featuredRank                                                           Int?
  featuredUntil                                                          DateTime?               @db.Timestamptz(6)
  language                                                               String?
  source                                                                 String?
  createdAt                                                              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                                                              DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  aestheticTags                                                          String[]
  age                                                                    Int?
  bio                                                                    String?
  era                                                                    String?
  gender                                                                 String?
  kinkTags                                                               String[]
  nsfw                                                                   Boolean                 @default(false)
  public                                                                 Boolean                 @default(true)
  race                                                                   String?
  relationshipTags                                                       String[]
  scenario                                                               String?
  greeting                                                               String?
  personalityTags                                                        String[]
  profileEmbedding                                                       Unsupported("vector")?
  sillyTavernCard                                                        Json?
  User                                                                   User?                   @relation(fields: [ownerId], references: [id], onUpdate: NoAction)
  assets                                                                 CompanionAsset[]
  categories                                                             CompanionCategory[]
  CompanionRelationship_CompanionRelationship_fromCompanionIdToCompanion CompanionRelationship[] @relation("CompanionRelationship_fromCompanionIdToCompanion")
  CompanionRelationship_CompanionRelationship_toCompanionIdToCompanion   CompanionRelationship[] @relation("CompanionRelationship_toCompanionIdToCompanion")
  conversations                                                          Conversation[]
  GenerationJob                                                          GenerationJob[]
  marketplaceListings                                                    MarketplaceListing?
  rpCampaignCharacters                                                   RpCampaignCharacter[]
  companion_embeddings                                                   companion_embeddings?

  @@index([createdAt])
  @@index([featuredRank])
  @@index([featuredUntil])
  @@index([language])
  @@index([likes, views])
  @@index([ownerId])
  @@index([visibility, contentRating], map: "Companion_vis_rating_idx")
  @@index([profileEmbedding], map: "Companion_profileEmbedding_ivfflat_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], map: "companion_description_trgm_idx", type: Gin)
  @@index([kinkTags], map: "companion_kink_tags_gin_idx", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "companion_name_trgm_idx", type: Gin)
  @@index([personalityTags], map: "companion_personality_tags_gin_idx", type: Gin)
  @@index([profile(ops: JsonbPathOps)], map: "companion_profile_gin_idx", type: Gin)
  @@index([public, contentRating, createdAt(sort: Desc)], map: "companion_public_rating_created_idx")
  @@index([relationshipTags], map: "companion_relationship_tags_gin_idx", type: Gin)
  @@index([tags], map: "companion_tags_gin_idx", type: Gin)
  @@index([visibility, contentRating, createdAt(sort: Desc)], map: "companion_visibility_rating_created_idx")
  @@schema("public")
}

model CompanionRelationship {
  id                                                         String    @id @default(cuid())
  createdByUserId                                            String?
  fromCompanionId                                            String
  toCompanionId                                              String
  relationType                                               String
  description                                                String?
  createdAt                                                  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                                                  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  Companion_CompanionRelationship_fromCompanionIdToCompanion Companion @relation("CompanionRelationship_fromCompanionIdToCompanion", fields: [fromCompanionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "CompanionRelationship_from_fkey")
  Companion_CompanionRelationship_toCompanionIdToCompanion   Companion @relation("CompanionRelationship_toCompanionIdToCompanion", fields: [toCompanionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "CompanionRelationship_to_fkey")

  @@unique([fromCompanionId, toCompanionId, relationType], map: "CompanionRelationship_unique")
  @@index([createdByUserId])
  @@index([fromCompanionId], map: "CompanionRelationship_from_idx")
  @@index([toCompanionId], map: "CompanionRelationship_to_idx")
  @@schema("public")
}

model CompanionReaction {
  id          String    @id @default(cuid())
  userId      String
  companionId String
  liked       Boolean   @default(false)
  saved       Boolean   @default(false)
  viewedAt    DateTime? @db.Timestamptz(6)

  @@unique([userId, companionId], map: "CompanionReaction_unique")
  @@index([companionId])
  @@schema("public")
}

model DiscoveryEvent {
  id          String          @id @default(cuid())
  userId      String
  companionId String
  action      DiscoveryAction
  source      String          @default("discover")
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([companionId, action, createdAt])
  @@index([action, createdAt])
  @@index([companionId, action, createdAt(sort: Desc)], map: "discovery_event_rollup_idx")
  @@schema("public")
}

model MarketplaceListing {
  id            String                   @id @default(cuid())
  listingType   MarketplaceListingType   @default(COMPANION)
  status        MarketplaceListingStatus @default(DRAFT)
  creatorId     String?
  companionId   String?                  @unique
  title         String
  subtitle      String?
  description   String?
  tags          String[]
  contentRating ContentRating            @default(SAFE)
  priceCoins    Int                      @default(0)
  priceUsdCents Int                      @default(0)
  coverAssetId  String?
  publishedAt   DateTime?                @db.Timestamptz(6)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  companion     Companion?               @relation(fields: [companionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator       User?                    @relation(fields: [creatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, listingType, contentRating, publishedAt])
  @@index([creatorId, status])
  @@index([contentRating, status, createdAt])
  @@index([tags], map: "marketplace_tags_gin_idx", type: Gin)
  @@schema("public")
}

model World {
  id             String         @id @default(cuid())
  ownerId        String
  name           String
  slug           String         @unique
  summary        String
  setting        String?
  contentRating  ContentRating  @default(SAFE)
  isPublic       Boolean        @default(true)
  maxMembers     Int            @default(8)
  lastActivityAt DateTime       @default(now()) @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  factions       Faction[]
  owner          User           @relation("WorldOwner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invites        WorldInvite[]
  members        WorldMember[]
  messages       WorldMessage[]

  @@index([ownerId, createdAt])
  @@index([isPublic, lastActivityAt])
  @@index([contentRating, isPublic, createdAt])
  @@index([isPublic, contentRating, lastActivityAt(sort: Desc)], map: "world_public_activity_idx")
  @@schema("public")
}

model WorldMember {
  id          String    @id @default(cuid())
  worldId     String
  userId      String
  role        WorldRole @default(PLAYER)
  displayName String?
  joinedAt    DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt  DateTime? @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  world       World     @relation(fields: [worldId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([worldId, userId])
  @@index([userId, joinedAt])
  @@index([worldId, role])
  @@index([worldId, role], map: "world_member_world_role_idx")
  @@schema("public")
}

model WorldMessage {
  id           String           @id @default(cuid())
  worldId      String
  authorUserId String?
  role         WorldMessageRole @default(USER)
  content      String
  metadata     Json             @default("{}")
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  authorUser   User?            @relation("WorldMessageAuthor", fields: [authorUserId], references: [id], onUpdate: NoAction)
  world        World            @relation(fields: [worldId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([worldId, createdAt])
  @@index([authorUserId, createdAt])
  @@schema("public")
}

model WorldInvite {
  id              String    @id @default(cuid())
  worldId         String
  code            String    @unique
  createdByUserId String
  maxUses         Int       @default(10)
  usedCount       Int       @default(0)
  expiresAt       DateTime? @db.Timestamptz(6)
  revokedAt       DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdByUser   User      @relation("WorldInviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  world           World     @relation(fields: [worldId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([worldId, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([expiresAt, revokedAt])
  @@schema("public")
}

model Faction {
  id          String                  @id @default(cuid())
  worldId     String?
  slug        String
  name        String
  description String?
  metadata    Json                    @default("{}")
  createdAt   DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  world       World?                  @relation(fields: [worldId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reputations UserFactionReputation[]

  @@unique([worldId, slug])
  @@index([slug])
  @@schema("public")
}

model UserFactionReputation {
  id            String   @id @default(cuid())
  userId        String
  factionId     String
  reputation    Int      @default(0)
  level         Int      @default(1)
  metadata      Json     @default("{}")
  lastUpdatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  faction       Faction  @relation(fields: [factionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, factionId])
  @@index([factionId, reputation])
  @@schema("public")
}

model SavedMessage {
  id            String   @id @default(cuid())
  userId        String
  messageId     String?
  content       String
  companionId   String
  companionName String
  coinPurchased Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([userId, messageId])
  @@schema("public")
}

model Content {
  id                String           @id @default(uuid())
  text              String
  tier              ContentTier
  flags             String[]         @default([])
  moderation_status ModerationStatus @default(pending)
  creator_id        String
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  User              User             @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt])
  @@index([creator_id], map: "Content_creator_idx")
  @@index([tier, moderation_status], map: "Content_tier_mod_idx")
  @@schema("public")
}

model CompanionAsset {
  id            String         @id @default(cuid())
  companionId   String
  ownerId       String?
  type          GenerationType
  contentRating ContentRating  @default(SAFE)
  storageBucket String
  storagePath   String
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  isFavorite    Boolean        @default(false)
  publicUrl     String?
  isCover       Boolean        @default(false)
  metadata      Json           @default("{}")
  companion     Companion      @relation(fields: [companionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User          User?          @relation(fields: [ownerId], references: [id], onUpdate: NoAction)

  @@index([companionId, type, contentRating], map: "CompanionAsset_combo_idx")
  @@schema("public")
}

model Conversation {
  id                String                      @id @default(cuid())
  userId            String
  companionId       String
  contentRating     ContentRating               @default(SAFE)
  createdAt         DateTime                    @default(now()) @db.Timestamptz(6)
  familiarity       Int                         @default(0)
  intimacy          Int                         @default(0)
  summary           String?
  trust             Int                         @default(0)
  updatedAt         DateTime                    @updatedAt
  deletedAt         DateTime?
  isPermanent       Boolean                     @default(false)
  memorySummary     String?
  companionMood     Int                         @default(0)
  lastActiveAt      DateTime?                   @db.Timestamptz(6)
  emotionalMemory   String?
  emotionalProfile  String?
  kinkLevel         Int                         @default(0)
  relationshipLevel Int                         @default(1)
  gameState         Json?
  messages          ChatMessage[]
  companion         Companion                   @relation(fields: [companionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progressEvents    RelationshipProgressEvent[]

  @@unique([userId, companionId])
  @@index([userId, companionId, contentRating, updatedAt], map: "Conversation_combo_idx")
  @@schema("public")
}

model Lorebook {
  id          String      @id @default(cuid())
  userId      String
  name        String
  description String?
  isGlobal    Boolean     @default(false)
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  entries     LoreEntry[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, enabled])
  @@schema("public")
}

model LoreEntry {
  id         String   @id @default(cuid())
  lorebookId String
  keys       String[]
  content    String
  constant   Boolean  @default(false)
  enabled    Boolean  @default(true)
  priority   Int      @default(100)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  lorebook   Lorebook @relation(fields: [lorebookId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lorebookId, enabled])
  @@schema("public")
}

model RelationshipProgressEvent {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  companionId    String
  eventType      String
  oldLevel       Int
  newLevel       Int
  familiarity    Int?
  trust          Int?
  intimacy       Int?
  kinkLevel      Int?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId, createdAt])
  @@index([userId, companionId, createdAt])
  @@schema("public")
}

model ChatMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           String
  content        String
  contentRating  ContentRating @default(SAFE)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  isPinned       Boolean       @default(false)
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  audio          MessageAudio?

  @@index([conversationId, createdAt], map: "Message_conv_created_idx")
  @@index([conversationId, isPinned], map: "Message_conv_pinned_idx")
  @@index([conversationId, createdAt(sort: Desc)], map: "chat_message_recent_idx")
  @@schema("public")
}

model MessageAudio {
  id            String      @id @default(cuid())
  messageId     String      @unique
  companionId   String
  provider      String
  voiceId       String
  model         String
  storageBucket String
  storagePath   String
  audioUrl      String
  contentType   String      @default("audio/mpeg")
  urlExpiresAt  DateTime    @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  message       ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([companionId, createdAt])
  @@schema("public")
}

model UserFact {
  id          String   @id @default(cuid())
  userId      String
  companionId String?
  fact        String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, companionId], map: "UserFact_user_companion_idx")
  @@schema("public")
}

model Category {
  id         String              @id @default(cuid())
  name       String
  slug       String              @unique
  type       CategoryType
  isAdult    Boolean             @default(false)
  order      Int                 @default(0)
  createdAt  DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime            @default(now()) @db.Timestamptz(6)
  companions CompanionCategory[]

  @@index([type, order])
  @@schema("public")
}

model CompanionCategory {
  companionId String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "CompanionCategory_category_fkey")
  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "CompanionCategory_companion_fkey")

  @@id([companionId, categoryId])
  @@index([categoryId], map: "CompanionCategory_category_idx")
  @@schema("public")
}

model GenerationJob {
  id                String         @id @default(cuid())
  userId            String
  companionId       String?
  type              GenerationType
  status            JobStatus      @default(PENDING)
  contentRating     ContentRating  @default(SAFE)
  prompt            String
  negativePrompt    String?
  resultBucket      String?
  resultPath        String?
  resultUrl         String?
  error             String?
  startedAt         DateTime?      @db.Timestamptz(6)
  finishedAt        DateTime?      @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  requestPreset     String?
  requestTag        String?
  requestUserPrompt String?
  companion         Companion?     @relation(fields: [companionId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, createdAt])
  @@index([userId, companionId, contentRating], map: "GenerationJob_user_comp_rating_idx")
  @@schema("public")
}

model User {
  id                   String                  @id @default(cuid())
  supabaseUserId       String                  @unique
  email                String?                 @unique
  dob                  DateTime?               @db.Timestamptz(6)
  region               String?
  displayName          String?
  ageVerifiedAt        DateTime?               @db.Timestamptz(6)
  role                 UserRole                @default(USER)
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  coinBalance          Int                     @default(100)
  plan                 SubscriptionPlan        @default(BASIC)
  stripeCustomerId     String?                 @unique
  stripeSubscriptionId String?                 @unique
  subscriptionStatus   String?
  subscriptionPriceId  String?                 @unique
  subscriptionTier     String?
  lastLoginRewardAt    DateTime?               @db.Timestamptz(6)
  loginStreak          Int                     @default(0)
  bannedAt             DateTime?               @db.Timestamptz(6)
  bannedReason         String?
  suspendedAt          DateTime?               @db.Timestamptz(6)
  suspendedReason      String?
  AuditLog             AuditLog[]
  coinTransactions     CoinTransaction[]
  Companion            Companion[]
  CompanionAsset       CompanionAsset[]
  Content              Content[]
  conversations        Conversation[]
  generationJobs       GenerationJob[]
  lorebooks            Lorebook[]
  marketplaceListings  MarketplaceListing[]
  premiumPurchases     PremiumPurchase[]
  reports              Report[]
  entitlements         UserEntitlement[]
  facts                UserFact[]
  factionReputations   UserFactionReputation[]
  worldsOwned          World[]                 @relation("WorldOwner")
  worldInvitesCreated  WorldInvite[]           @relation("WorldInviteCreator")
  worldMemberships     WorldMember[]
  worldMessages        WorldMessage[]          @relation("WorldMessageAuthor")

  @@schema("public")
}

model UserEntitlement {
  id         String    @id @default(cuid())
  userId     String
  featureKey String
  quantity   Int       @default(0)
  isActive   Boolean   @default(true)
  expiresAt  DateTime? @db.Timestamptz(6)
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, featureKey])
  @@index([featureKey, isActive])
  @@schema("public")
}

model PremiumPurchase {
  id         String   @id @default(cuid())
  userId     String
  sku        String
  featureKey String
  coinsSpent Int
  quantity   Int      @default(0)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([featureKey, createdAt])
  @@schema("public")
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetType ReportTarget
  targetId   String
  reason     ReportReason
  details    String?
  status     ReportStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?    @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@schema("public")
}

model CoinTransaction {
  id                    String   @id @default(cuid())
  userId                String
  amount                Int
  kind                  String
  description           String?
  stripeSessionId       String?
  stripePaymentIntentId String?
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@schema("public")
}

model AuditLog {
  id        String   @id @default(uuid())
  user_id   String
  action    String
  metadata  Json?
  ip        String?
  platform  String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  User      User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([action])
  @@index([createdAt])
  @@index([user_id])
  @@schema("public")
}

model accounts {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         BigInt?
