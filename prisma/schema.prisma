  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String
  companion_id    String
  conversation_id String?
  kind            String                 @default("fact")
  content         String
  importance      Int                    @default(3)
  embedding       Unsupported("vector")?
  metadata        Json?                  @default("{}")
  created_at      DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?              @default(now()) @db.Timestamptz(6)

  @@index([user_id, companion_id], map: "companion_memories_user_companion_idx")
  @@index([embedding], map: "companion_memories_embedding_idx")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rag_document_sections {
  id            BigInt                @id @default(autoincrement())
  document_id   BigInt
  content       String
  embedding     Unsupported("vector")
  metadata      Json                  @default("{}")
  created_at    DateTime              @default(now()) @db.Timestamptz(6)
  rag_documents rag_documents         @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([document_id])
  @@index([embedding], map: "rag_document_sections_embedding_hnsw_idx")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rag_documents {
  id                    BigInt                  @id @default(autoincrement())
  owner_id              String                  @default(dbgenerated("auth.uid()")) @db.Uuid
  source                String?
  title                 String
  metadata              Json                    @default("{}")
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  rag_document_sections rag_document_sections[]
  users                 auth_users              @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([owner_id])
  @@schema("public")
}

model CompanionMemory {
  id          String                 @id @default(cuid())
  userId      String
  companionId String
  scope       MemoryScope
  type        MemoryType
  content     String                 @default("@dbText")
  importance  Int                    @default(50)
  confidence  Float                  @default(1.0)
  bucket      ContentBucket
  tags        String[]
  embeddingId String?
  expiresAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  embedding   Unsupported("vector")?

  @@index([userId, companionId, scope])
  @@index([bucket])
  @@index([type])
  @@index([embedding])
  @@schema("public")
}

model RelationshipState {
  id              String    @id @default(cuid())
  userId          String
  companionId     String
  affection       Int       @default(0)
  trust           Int       @default(0)
  tension         Int       @default(0)
  jealousy        Int       @default(0)
  intimacy        Int       @default(0)
  familiarity     Int       @default(0)
  mood            String    @default("neutral")
  lastInteraction DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, companionId])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model companion_embeddings {
  companion_id String                @id
  content      String
  embedding    Unsupported("vector")
  metadata     Json                  @default("{}")
  created_at   DateTime              @default(now()) @db.Timestamptz(6)
  updated_at   DateTime              @default(now()) @db.Timestamptz(6)
  Companion    Companion             @relation(fields: [companion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([embedding], map: "companion_embeddings_hnsw_idx")
  @@schema("public")
}

model RpCampaign {
  id          String                @id @default(cuid())
  userId      String
  companionId String?
  title       String
  genre       String?
  tone        String?
  status      String                @default("ACTIVE")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  characters  RpCampaignCharacter[]
  messages    RpMessage[]
  scenes      RpScene[]
  sessions    RpSession[]

  @@schema("public")
}

model RpCampaignCharacter {
  id          String     @id @default(cuid())
  campaignId  String
  companionId String
  role        String     @default("cast")
  joinedAt    DateTime   @default(now())
  campaign    RpCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  companion   Companion  @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([campaignId, companionId])
  @@index([campaignId, joinedAt])
  @@index([companionId])
  @@schema("public")
}

model RpSession {
  id             String      @id @default(cuid())
  campaignId     String
  title          String?
  summary        String?
  currentSceneId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  messages       RpMessage[]
  campaign       RpCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model RpMessage {
  id          String      @id @default(cuid())
  campaignId  String
  sessionId   String?
  speakerType SpeakerType
  content     String
  imageUrl    String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  campaign    RpCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session     RpSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([sessionId, createdAt])
  @@schema("public")
}

model RpScene {
  id          String     @id @default(cuid())
  campaignId  String
  title       String
  location    String?
  mood        String?
  summary     String?
  imagePrompt String?
  imageUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaign    RpCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@schema("public")
}

